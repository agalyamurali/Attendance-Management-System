# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# --- Database ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/attendance_db

# --- JWT / Security ---
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=90

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- App metadata ---
APP_NAME=Mini Attendance Management System
ENVIRONMENT=development
